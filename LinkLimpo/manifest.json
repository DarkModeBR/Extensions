{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "short_name": "LinkLimpo",
  "description": "__MSG_extDescription__",
  "version": "1.0.0",
  "default_locale": "pt_BR",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/on-16.png",
    "32": "icons/on-32.png",
    "48": "icons/on-48.png",
    "128": "icons/on-128.png"
  },
  "action": {
    "default_popup": "src/ui/popup.html",
    "default_title": "LinkLimpo",
    "default_icon": {
      "16": "icons/on-16.png",
      "32": "icons/on-32.png",
      "48": "icons/on-48.png",
      "128": "icons/on-128.png"
    }
  },
  "background": {
    "service_worker": "src/background/service-worker.js"
  },
  "options_ui": {
    "page": "src/ui/options.html",
    "open_in_tab": true
  },
  "permissions": [
    "declarativeNetRequest",
    "declarativeNetRequestFeedback",
    "storage",
    "contextMenus",
    "alarms",
    "webNavigation",
    "offscreen"
  ],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["src/core/settings.js", "src/core/engine.js", "src/content/content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "commands": {
    "copy-clean-url": {
      "suggested_key": { "default": "Alt+Shift+C" },
      "description": "__MSG_cmdCopy__"
    }
  }
}
