{
  "manifest_version": 3,
  "name": "Sonar — CAPTCHA Audio Solver",
  "short_name": "Sonar",
  "version": "1.3.0",
  "description": "Resolve o desafio de áudio do reCAPTCHA com o Whisper rodando no seu computador. Grátis, rápido e sem chave.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "assets/icons/icon-16.png",
    "32": "assets/icons/icon-32.png",
    "48": "assets/icons/icon-48.png",
    "128": "assets/icons/icon-128.png"
  },
  "action": {
    "default_title": "Sonar",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "assets/icons/icon-16.png",
      "32": "assets/icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "src/background/background.js"
  },
  "options_page": "src/options/options.html",
  "permissions": ["storage", "offscreen"],
  "host_permissions": [
    "https://www.google.com/recaptcha/*",
    "https://www.recaptcha.net/recaptcha/*",
    "https://recaptcha.google.com/recaptcha/*",
    "https://huggingface.co/*",
    "https://*.hf.co/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.google.com/recaptcha/api2/bframe*",
        "https://www.google.com/recaptcha/enterprise/bframe*",
        "https://www.recaptcha.net/recaptcha/api2/bframe*",
        "https://www.recaptcha.net/recaptcha/enterprise/bframe*",
        "https://recaptcha.google.com/recaptcha/api2/bframe*",
        "https://recaptcha.google.com/recaptcha/enterprise/bframe*"
      ],
      "js": ["src/shared/defaults.js", "src/content/overlay.js", "src/content/bframe.js"],
      "css": ["src/content/bframe.css"],
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.google.com/recaptcha/api2/anchor*",
        "https://www.google.com/recaptcha/enterprise/anchor*",
        "https://www.recaptcha.net/recaptcha/api2/anchor*",
        "https://www.recaptcha.net/recaptcha/enterprise/anchor*",
        "https://recaptcha.google.com/recaptcha/api2/anchor*",
        "https://recaptcha.google.com/recaptcha/enterprise/anchor*"
      ],
      "js": ["src/shared/defaults.js", "src/content/anchor.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["assets/fonts/bricolage.woff2", "assets/fonts/onest.woff2"],
      "matches": ["https://www.google.com/*", "https://www.recaptcha.net/*", "https://recaptcha.google.com/*"]
    }
  ],
  "commands": {
    "solve": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Resolver o reCAPTCHA aberto nesta aba"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "cross_origin_embedder_policy": {
    "value": "require-corp"
  },
  "cross_origin_opener_policy": {
    "value": "same-origin"
  }
}
